.DS_Store
.wrangler/

# Local agent outputs (one-off pitch / artifact runs that don't belong in git)
outputs/

# Python build artifacts
__pycache__/
*.pyc

# VibeLoom build artifacts — extracted templates
# (canonical source is vibeloom-templates.md; templates/ is regenerable via extract-templates.py)
v03/templates/

# Release-asset staging (tarballs go to GitHub releases, not into git)
dist/

# build-bundle.sh leaves a pointer to its last /tmp staging dir
.last-bundle-staging.txt
